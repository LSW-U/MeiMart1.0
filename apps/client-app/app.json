{
  "expo": {
    "name": "MeiMart",
    "slug": "mei-mart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#961813"
    },
    "scheme": "meimart",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meimart.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MeiMart 需要访问相机以上传商品图片和扫描二维码。",
        "NSPhotoLibraryUsageDescription": "MeiMart 需要访问相册以上传头像和评价图片。",
        "NSLocationWhenInUseUsageDescription": "MeiMart 需要访问位置以推荐附近商品和地址自动填充。",
        "NSContactsUsageDescription": "MeiMart 可读取联系人以快速填充收货地址。",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appStoreUrl": "TODO-[需用户]"
    },
    "android": {
      "package": "com.meimart.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.meimart.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "APP_ENV": "development",
      "API_BASE_URL": "http://localhost:3000/api/v1",
      "USE_MOCK": "false",
      "SENTRY_DSN": "",
      "eas": {
        "projectId": "TODO-[需用户]"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-font",
      "expo-status-bar",
      [
        "expo-updates",
        {
          "username": "TODO-[需用户]"
        }
      ],
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your location on the map to pick a delivery address."
        }
      ]
    ],
    "updates": {
      "url": "TODO-[需用户]"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "TODO-[需用户]",
    "privacy": "unlisted",
    "description": "MeiMart - Timor-Leste 本地电商应用",
    "githubUrl": "TODO-[需用户]",
    "primaryColor": "#961813"
  },
  "_comment": "占位符说明（M0-1.6）：所有 TODO-[需用户] 的值都等用户开通 EAS 账号 / App Store / Google Play 后提供，禁止编造假值。涉及字段：extra.eas.projectId、owner、updates.url、plugins[expo-updates].username、ios.appStoreUrl、githubUrl。extra 里的 APP_ENV/API_BASE_URL/USE_MOCK/SENTRY_DSN 会在构建时被 app.config.ts 用 EXPO_PUBLIC_* 环境变量覆盖。"
}
