{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000/api/v1",
        "EXPO_PUBLIC_USE_MOCK": "false"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.meimart.com/api/v1",
        "EXPO_PUBLIC_USE_MOCK": "false"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "TODO-[需用户]",
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_SENTRY_DSN": "TODO-[需用户]"
      },
      "autoIncrement": true,
      "ios": {
        "applicationArchivePath": "build/MeiMart.ipa"
      },
      "android": {
        "applicationArchivePath": "build/MeiMart.aab"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TODO-[需用户]",
        "ascAppId": "TODO-[需用户]",
        "appleTeamId": "TODO-[需用户]"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-service-account.json",
        "track": "internal"
      }
    }
  }
}
