{
  "expo": {
    "name": "Mei Delivery App",
    "slug": "mei-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mei-delivery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meimart.delivery",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MeiMart 需要您的位置以在配送地图上显示骑手位置，并在配送期间持续追踪以确保订单准时送达。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "App 切到后台或锁屏时仍需持续上报您的位置，以便客户实时看到配送进度。仅在配送中生效。",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.meimart.delivery",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许 MeiMart 获取您的位置以显示配送地图。",
          "locationAlwaysAndWhenInUsePermission": "允许 MeiMart 在配送期间持续获取您的位置。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "630c349f-283f-4d6c-8fb0-42b18c79fdee"
      }
    },
    "owner": "suweilin"
  }
}
