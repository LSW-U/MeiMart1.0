# MeiMart rider-app（骑手端）环境变量模板 —— 复制为 .env 后填真实值
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# mock 开关（默认 mock：不设或设非 false 值 + URL 为空 → mock 分支）：
# 想连真实后端设 EXPO_PUBLIC_USE_MOCK=false（且 URL 必填）
EXPO_PUBLIC_USE_MOCK=true
# 运行环境标识（app.config.ts:22 注入 extra.APP_ENV；如 development/production）
EXPO_PUBLIC_APP_ENV=development
# Sentry 数据源（app.config.ts:25 注入 extra.SENTRY_DSN；留空则 Sentry 允许失败不上报）
EXPO_PUBLIC_SENTRY_DSN=
